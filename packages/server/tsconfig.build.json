{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Off. packages/ee is written against this package's source through the
    // exports map, the way every other package here is consumed, so there is
    // nothing for a .d.ts to tell anybody.
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-utils.ts"
  ]
}
