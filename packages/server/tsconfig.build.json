{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // On, because packages/ee is written against src/index.ts and imports it by
    // its built path. Nothing else consumes this package as a library: the
    // Docker image runs dist/server.js and the dashboard's browser fixture
    // imports dist/app.js from JavaScript.
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test-utils.ts"
  ]
}
