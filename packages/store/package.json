{
  "name": "@chokh/store",
  "version": "0.0.0",
  "private": true,
  "description": "The Chokh AnalyticsStore contract and the conformance suite every adapter passes.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./src/conformance/index.ts",
      "default": "./dist/conformance/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chokh/geo": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.js"
      }
    }
  }
}
