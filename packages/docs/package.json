{
  "name": "@chokh/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Chokh documentation site, built static from Markdown by a script of its own.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "site": "node scripts/build.mjs",
    "site:serve": "node scripts/serve.mjs",
    "site:links": "node scripts/check-links.mjs",
    "site:a11y": "node scripts/a11y.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "site:examples": "tsc -p tsconfig.examples.json",
    "site:generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@chokh/next": "workspace:*",
    "@chokh/react": "workspace:*",
    "@chokh/sdk-node": "workspace:*",
    "@chokh/server": "workspace:*",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.7",
    "esbuild": "^0.25.0",
    "lighthouse": "12.2.2",
    "markdown-it": "^15.0.3",
    "minisearch": "^7.2.0",
    "next": "^16.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  }
}
